@using MyProject.Web.Models.Common.Modals
@using MyProject.Web.Models.Suppliers
@model EditSupplierViewModel
@{
	Layout = null;
}
@await Html.PartialAsync("~/Views/Shared/Modals/_ModalHeader.cshtml", new ModalHeaderViewModel("Sửa nhà cung cấp"))
<form name="supplierEditForm" role="form" class="form-horizontal">
	<input type="hidden" name="Id" value="@Model.Supplier.Id" />
	<div class="modal-body">
		<div class="form-group row required">
			<label class="col-md-3 col-form-label">Tên nhà cung cấp</label>
			<div class="col-md-9">
				<input type="text" class="form-control" name="Name" value="@Model.Supplier.Name" required maxlength="256">
			</div>
		</div>
		<div class="form-group row">
			<label class="col-md-3 col-form-label">Mã nhà cung cấp</label>
			<div class="col-md-9">
				<input type="text" class="form-control" name="Code" value="@(Model.Supplier.Code ?? "")" maxlength="50">
			</div>
		</div>
		<div class="form-group row">
			<label class="col-md-3 col-form-label">Điện thoại</label>
			<div class="col-md-9">
				<input type="text" class="form-control" name="Phone" value="@(Model.Supplier.Phone ?? "")" maxlength="20">
			</div>
		</div>
		<div class="form-group row">
			<label class="col-md-3 col-form-label">Email</label>
			<div class="col-md-9">
				<input type="email" class="form-control" name="Email" value="@(Model.Supplier.Email ?? "")" maxlength="256">
			</div>
		</div>
		<div class="form-group row">
			<label class="col-md-3 col-form-label">Địa chỉ</label>
			<div class="col-md-9">
				<textarea class="form-control" name="Address" rows="2" maxlength="500">@(Model.Supplier.Address ?? "")</textarea>
			</div>
		</div>
		<div class="form-group row">
			<label class="col-md-3 col-form-label">Người liên hệ</label>
			<div class="col-md-9">
				<input type="text" class="form-control" name="ContactPerson" value="@(Model.Supplier.ContactPerson ?? "")" maxlength="256">
			</div>
		</div>
		<div class="form-group row">
			<label class="col-md-3 col-form-label">Ghi chú</label>
			<div class="col-md-9">
				<textarea class="form-control" name="Notes" rows="3" maxlength="1000">@(Model.Supplier.Notes ?? "")</textarea>
			</div>
		</div>
		<div class="form-group row">
			<label class="col-md-3 col-form-label">Trạng thái</label>
			<div class="col-md-9">
				<label class="checkbox-inline">
					<input type="checkbox" name="IsActive" @(Model.Supplier.IsActive ? "checked" : "")> Kích hoạt
				</label>
			</div>
		</div>
	</div>
	@await Html.PartialAsync("~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")
</form>

<script src="~/view-resources/Views/Suppliers/_EditModal.js" asp-append-version="true"></script>

