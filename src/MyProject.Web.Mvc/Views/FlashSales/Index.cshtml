@using MyProject.Web.Startup
@using Abp.Application.Services.Dto
@using MyProject.FlashSales.Dto
@model PagedResultDto<FlashSaleDto>
@{
	ViewBag.Title = L("FlashSales");
	ViewBag.CurrentPageName = PageNames.FlashSales;
}
@section scripts
{
	<environment names="Development">
		<script src="~/view-resources/Views/FlashSales/Index.js" asp-append-version="true"></script>
	</environment>

	<environment names="Staging,Production">
		<script src="~/view-resources/Views/FlashSales/Index.min.js" asp-append-version="true"></script>
	</environment>
}
<section class="content-header">
	<div class="container-fluid">
		<div class="row">
			<div class="col-sm-6">
				<h1>@L("FlashSales")</h1>
			</div>
			<div class="col-sm-6">
				<a href="javascript:;" data-toggle="modal" data-target="#FlashSaleCreateModal" class="btn bg-blue float-sm-right">
					<i class="fa fa-plus-square"></i>
					@L("Create")
				</a>
			</div>
		</div>
	</div>
</section>
<section class="content">
	<div class="container-fluid">
		<div class="row">
			<div class="col-12">
				<div class="card">
					<div class="card-header">
						<div class="row">
							<div class="col-md-6">
								<!--Use for bulk actions-->
							</div>
							<div class="col-md-6">
								@await Html.PartialAsync("~/Views/FlashSales/Search.cshtml")
							</div>
						</div>
					</div>
					<div class="card-body">
						<div class="table-responsive">
							<table id="FlashSalesTable" class="table table-striped table-bordered">
								<thead>
									<tr>
										<th></th>
										<th>@L("Name")</th>
										<th>@L("StartTime")</th>
										<th>@L("EndTime")</th>
										<th>@L("Status")</th>
										<th>@L("TotalProducts")</th>
										<th>@L("TotalSold")</th>
										<th>@L("IsActive")</th>
										<th>@L("IsHidden")</th>
										<th style="width: 200px">@L("Actions")</th>
									</tr>
								</thead>
								<tbody></tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

@{
	var createFlashSaleDto = new CreateFlashSaleDto();
}
@await Html.PartialAsync("~/Views/FlashSales/_CreateModal.cshtml", createFlashSaleDto)

<!-- Edit Modal -->
<div class="modal fade" id="FlashSaleEditModal" tabindex="-1" role="dialog" aria-labelledby="FlashSaleEditModalLabel" data-backdrop="static">
	<div class="modal-dialog modal-lg" role="document">
		<div class="modal-content">
		</div>
	</div>
</div>

