@using MyProject.Web.Startup
@using MyProject.FlashSales.Dto
@model FlashSaleDto
@{
	ViewBag.Title = L("FlashSaleDetail");
	ViewBag.CurrentPageName = PageNames.FlashSales;
}
@section scripts
{
	<environment names="Development">
		<script src="~/view-resources/Views/FlashSales/Detail.js" asp-append-version="true"></script>
	</environment>

	<environment names="Staging,Production">
		<script src="~/view-resources/Views/FlashSales/Detail.min.js" asp-append-version="true"></script>
	</environment>
}
<section class="content-header">
	<div class="container-fluid">
		<div class="row">
			<div class="col-sm-6">
				<h1>@Model.Name</h1>
			</div>
			<div class="col-sm-6">
				<a href="/FlashSales" class="btn bg-secondary float-sm-right">
					<i class="fa fa-arrow-left"></i> @L("Back")
				</a>
			</div>
		</div>
	</div>
</section>

<section class="content">
	<div class="container-fluid">
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<h3 class="card-title">@L("FlashSaleInfo")</h3>
					</div>
					<div class="card-body">
						<div class="row">
							<div class="col-md-6">
								<div class="form-group">
									<label class="font-weight-bold">@L("Name"):</label>
									<p class="form-control-plaintext">@Model.Name</p>
								</div>
							</div>
							<div class="col-md-6">
								<div class="form-group">
									<label class="font-weight-bold">@L("Status"):</label>
									<p class="form-control-plaintext">
										<span class="badge bg-info">@Model.StatusText</span>
									</p>
								</div>
							</div>
						</div>
						<div class="row">
							<div class="col-md-6">
								<div class="form-group">
									<label class="font-weight-bold">@L("StartTime"):</label>
									<p class="form-control-plaintext">@Model.StartTime.ToString("dd/MM/yyyy HH:mm")</p>
								</div>
							</div>
							<div class="col-md-6">
								<div class="form-group">
									<label class="font-weight-bold">@L("EndTime"):</label>
									<p class="form-control-plaintext">@Model.EndTime.ToString("dd/MM/yyyy HH:mm")</p>
								</div>
							</div>
						</div>
						@if (!string.IsNullOrEmpty(Model.Description))
						{
							<div class="row">
								<div class="col-md-12">
									<div class="form-group">
										<label class="font-weight-bold">@L("Description"):</label>
										<p class="form-control-plaintext">@Model.Description</p>
									</div>
								</div>
							</div>
						}
					</div>
				</div>
			</div>
		</div>

		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="row">
							<div class="col-md-6">
								<h3 class="card-title">@L("Products")</h3>
							</div>
							<div class="col-md-6">
								<button type="button" class="btn btn-primary float-sm-right" data-toggle="modal" data-target="#AddProductModal">
									<i class="fa fa-plus"></i> @L("AddProduct")
								</button>
							</div>
						</div>
					</div>
					<div class="card-body">
						<div class="table-responsive">
							<table id="FlashSaleProductsTable" class="table table-striped table-bordered">
								<thead>
									<tr>
										<th>@L("ProductName")</th>
										<th>@L("OriginalPrice")</th>
										<th>@L("FlashSalePrice")</th>
										<th>@L("FlashSaleQuantity")</th>
										<th>@L("SoldQuantity")</th>
										<th>@L("RemainingQuantity")</th>
										<th>@L("MaxQuantityPerUser")</th>
										<th style="width: 150px">@L("Actions")</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var product in Model.Products)
									{
										<tr>
											<td>@product.ProductName</td>
											<td>@product.OriginalPrice.ToString("N0") đ</td>
											<td><strong class="text-danger">@product.FlashSalePrice.ToString("N0") đ</strong></td>
											<td>@product.FlashSaleQuantity</td>
											<td>@product.SoldQuantity</td>
											<td>@product.RemainingQuantity</td>
											<td>@(product.MaxQuantityPerUser?.ToString() ?? "Không giới hạn")</td>
											<td>
												<button type="button" class="btn btn-sm bg-secondary edit-product" data-product-id="@product.Id">
													<i class="fas fa-pencil-alt"></i> @L("Edit")
												</button>
												<button type="button" class="btn btn-sm bg-danger delete-product" data-product-id="@product.Id" data-product-name="@product.ProductName">
													<i class="fas fa-trash"></i> @L("Delete")
												</button>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- Add Product Modal -->
<div class="modal fade" id="AddProductModal" tabindex="-1" role="dialog" aria-labelledby="AddProductModalLabel" data-backdrop="static">
	<div class="modal-dialog modal-lg" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h4 class="modal-title">@L("AddProductToFlashSale")</h4>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<form id="AddProductForm">
				<input type="hidden" name="FlashSaleId" value="@Model.Id" />
				<div class="modal-body">
					<div class="form-group row required">
						<label class="col-md-3 col-form-label" for="ProductId">@L("Product")</label>
						<div class="col-md-9">
							<select id="ProductId" name="ProductId" class="form-control" required>
								<option value="">-- Chọn sản phẩm --</option>
							</select>
						</div>
					</div>
					<div class="form-group row required">
						<label class="col-md-3 col-form-label" for="FlashSalePrice">@L("FlashSalePrice")</label>
						<div class="col-md-9">
							<input id="FlashSalePrice" type="number" step="0.01" class="form-control" name="FlashSalePrice" required min="0.01">
						</div>
					</div>
					<div class="form-group row required">
						<label class="col-md-3 col-form-label" for="FlashSaleQuantity">@L("FlashSaleQuantity")</label>
						<div class="col-md-9">
							<input id="FlashSaleQuantity" type="number" class="form-control" name="FlashSaleQuantity" required min="1">
							<small class="form-text text-muted" id="AvailableQuantityText"></small>
						</div>
					</div>
					<div class="form-group row">
						<label class="col-md-3 col-form-label" for="MaxQuantityPerUser">@L("MaxQuantityPerUser")</label>
						<div class="col-md-9">
							<input id="MaxQuantityPerUser" type="number" class="form-control" name="MaxQuantityPerUser" min="1">
							<small class="form-text text-muted">Để trống nếu không giới hạn</small>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-dismiss="modal">@L("Cancel")</button>
					<button type="submit" class="btn btn-primary">@L("Save")</button>
				</div>
			</form>
		</div>
	</div>
</div>

<!-- Edit Product Modal -->
<div class="modal fade" id="EditProductModal" tabindex="-1" role="dialog" aria-labelledby="EditProductModalLabel" data-backdrop="static">
	<div class="modal-dialog modal-lg" role="document">
		<div class="modal-content">
		</div>
	</div>
</div>

