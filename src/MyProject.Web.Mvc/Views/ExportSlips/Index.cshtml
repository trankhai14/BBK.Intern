@using MyProject.Web.Models.ExportSlips
@model ExportSlipViewModel
@using MyProject.Web.Startup
@{
	ViewBag.Title = "Quản lý phiếu xuất kho";
	ViewBag.CurrentPageName = PageNames.ExportSlips;
}

@section scripts
{
	<environment names="Development">
		<script src="~/view-resources/Views/ExportSlips/Index.js" asp-append-version="true"></script>
	</environment>

	<environment names="Staging,Production">
		<script src="~/view-resources/Views/ExportSlips/Index.min.js" asp-append-version="true"></script>
	</environment>
}

<section class="content-header">
	<div class="container-fluid">
		<div class="row">
			<div class="col-sm-6">
				<h1>Quản lý phiếu xuất kho</h1>
			</div>
			<div class="col-sm-6">
				<a href="javascript:;" data-toggle="modal" data-target="#ExportSlipCreateModal" class="btn bg-blue float-sm-right">
					<i class="fa fa-plus-square"></i>
					Tạo phiếu xuất mới
				</a>
			</div>
		</div>
	</div>
</section>

<section class="content">
	<div class="container-fluid">
		<div class="row">
			<div class="col-12">
				<div class="card">
					<div class="card-header">
						<div class="row">
							<div class="col-md-12">
								<!-- Search form -->
								<div class="row">
									<div class="col-md-3">
										<input type="text" id="SearchExportCode" class="form-control" placeholder="Mã phiếu xuất...">
									</div>
									<div class="col-md-2">
										<select id="SearchStatus" class="form-control">
											<option value="">Tất cả trạng thái</option>
											<option value="0">Nháp</option>
											<option value="1">Đã hoàn thành</option>
											<option value="2">Đã hủy</option>
										</select>
									</div>
									<div class="col-md-2">
										<select id="SearchType" class="form-control">
											<option value="">Tất cả loại</option>
											<option value="1">Xuất cho đơn hàng</option>
											<option value="2">Xuất trả nhà cung cấp</option>
											<option value="3">Xuất hỏng hóc</option>
											<option value="4">Xuất điều chỉnh</option>
											<option value="5">Xuất chuyển kho</option>
										</select>
									</div>
									<div class="col-md-2">
										<input type="date" id="SearchFromDate" class="form-control" placeholder="Từ ngày">
									</div>
									<div class="col-md-2">
										<input type="date" id="SearchToDate" class="form-control" placeholder="Đến ngày">
									</div>
									<div class="col-md-1">
										<button type="button" id="SearchButton" class="btn btn-primary">
											<i class="fa fa-search"></i> Tìm
										</button>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="card-body">
						<div class="table-responsive">
							<table id="ExportSlipsTable" class="table table-striped table-bordered">
								<thead>
									<tr>
										<th>Mã phiếu</th>
										<th>Ngày xuất</th>
										<th>Đơn hàng</th>
										<th>Nhà cung cấp</th>
										<th>Loại xuất</th>
										<th>Trạng thái</th>
										<th>Lý do</th>
										<th>Số sản phẩm</th>
										<th>Người tạo</th>
										<th style="width: 250px">Thao tác</th>
									</tr>
								</thead>
								<tbody>
									<!-- Dữ liệu sẽ render bằng DataTable / Ajax -->
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

@await Html.PartialAsync("~/Views/ExportSlips/_CreateModal.cshtml", Model)

<!-- Edit Modal -->
<div class="modal fade" id="ExportSlipEditModal" tabindex="-1" role="dialog" aria-labelledby="ExportSlipEditModalLabel" data-backdrop="static">
	<div class="modal-dialog modal-xl" role="document">
		<div class="modal-content">
			<!-- Content will be loaded dynamically -->
		</div>
	</div>
</div>

