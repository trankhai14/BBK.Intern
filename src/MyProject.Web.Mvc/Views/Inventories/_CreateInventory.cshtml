@using MyProject.Web.Models.Common.Modals
@using MyProject.Web.Models.Inventories
@using MyProject.Inventories
@model InventoryViewModel

@{
  Layout = null;
}

<div class="modal fade" id="InventoryCreateModal" tabindex="-1" role="dialog" aria-labelledby="InventoryCreateModalLabel" data-backdrop="static">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      @await Html.PartialAsync("~/Views/Shared/Modals/_ModalHeader.cshtml", new ModalHeaderViewModel(L("CreateNewInventory")))

      <form name="inventoryCreateForm" role="form" class="form-horizontal">
        <div class="modal-body">

          <!-- Chọn sản phẩm -->
          <div class="form-group row mb-3 required">
            <label class="col-md-3 col-form-label fw-bold">@L("Product")</label>
            <div class="col-md-9 d-flex">
              <input 
                type="text" 
                id="ProductName" 
                name="ProductName" 
                class="form-control me-2" 
                placeholder="-- Chọn sản phẩm --" 
                readonly 
                required 
                style="background: #fff; cursor:pointer;"
                onclick="$('#ProductSelectModal').modal('show');"
              />
              <input type="hidden" id="ProductId" name="ProductId" required />
              @* <button type="button" class="btn btn-primary ms-2" onclick="$('#ProductSelectModal').modal('show');">
                <i class="fa fa-search"></i>
              </button> *@
            </div>
          </div>

          <!-- Số lượng tồn kho -->
          <div class="form-group row mb-3 required">
            <label class="col-md-3 col-form-label fw-bold">@L("Quantity")</label>
            <div class="col-md-9">
              <input type="number" class="form-control" name="Quantity" required min="0" value="0" placeholder="Nhập số lượng tồn...">
            </div>
          </div>

          <!-- Số lượng đã đặt -->
          <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label fw-bold">@L("ReservedQuantity")</label>
            <div class="col-md-9">
              <input type="number" class="form-control" name="ReservedQuantity" min="0" value="0" placeholder="Số lượng đã đặt (nếu có)">
            </div>
          </div>

          <!-- Ngưỡng đặt lại -->
          <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label fw-bold">Ngưỡng đặt lại</label>
            <div class="col-md-9">
              <input type="number" class="form-control" name="ReorderLevel" min="0" value="0" placeholder="Ngưỡng cảnh báo cần đặt lại">
            </div>
          </div>

          <!-- Số lượng tối thiểu -->
          <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label fw-bold">Số lượng tối thiểu</label>
            <div class="col-md-9">
              <input type="number" class="form-control" name="MinQuantity" min="0" value="0" placeholder="Ngưỡng sắp hết hàng">
            </div>
          </div>

          <!-- Đơn vị tính -->
          <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label fw-bold">@L("Unit")</label>
            <div class="col-md-9">
              <input type="text" class="form-control" name="Unit" maxlength="50" value="cái" placeholder="Đơn vị tính (cái, hộp, thùng...)">
            </div>
          </div>

          <!-- Trạng thái -->
          <div class="form-group row mb-3 required">
            <label class="col-md-3 col-form-label fw-bold">@L("Status")</label>
            <div class="col-md-9">
              <select class="form-control" name="Status" id="Status" required>
                <option value="1" selected>Đang hoạt động</option>
                <option value="2">Tạm ngưng</option>
                <option value="3">Ngừng kinh doanh</option>
              </select>
            </div>
          </div>

          <!-- Ghi chú -->
          <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label fw-bold">Ghi chú</label>
            <div class="col-md-9">
              <textarea class="form-control" name="Notes" maxlength="500" rows="3" placeholder="Nhập ghi chú (nếu có)"></textarea>
            </div>
          </div>
        </div>

        @await Html.PartialAsync("~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")
      </form>
    </div>
  </div>
</div>

<!-- Modal chọn sản phẩm -->
<div class="modal fade" id="ProductSelectModal" tabindex="-1" role="dialog" aria-labelledby="ProductSelectModalLabel" data-backdrop="static">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      @await Html.PartialAsync("~/Views/Inventories/_ProductSelectModal.cshtml")
    </div>
  </div>
</div>

