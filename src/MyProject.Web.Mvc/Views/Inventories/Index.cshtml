@model MyProject.Inventories.Dto.InventoryListDto
@{
  ViewBag.Title = L("Inventories");
}

@section scripts
{
  <environment names="Development">
    <script src="~/view-resources/Views/Inventories/Index.js" asp-append-version="true"></script>
  </environment>

  <environment names="Staging,Production">
    <script src="~/view-resources/Views/Inventories/Index.min.js" asp-append-version="true"></script>
  </environment>
}


<section class="content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-sm-6">
        <h1>@L("Inventories")</h1>
      </div>
    </div>
  </div>
</section>

<section class="content">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        @* @await Html.PartialAsync("~/Views/Inventories/Search.cshtml") *@
        <div class="card">
          <div class="card-header">
            <div class="row">
              <div class="col-md-6">
                <!-- Chỗ thêm nút Add Inventory -->
                <a href="javascript:;" data-toggle="modal" data-target="#InventoryCreateModal" class="btn bg-blue float-sm-right">
                  <i class="fa fa-plus-square"></i>
                  @L("Create")
                </a>
              </div>
            </div>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table id="InventoriesTable" class="table table-striped table-bordered">
                <thead>
                  <tr>
                    <th>@L("ProductName")</th>
                    <th style="width:120px">@L("Quantity")</th>
                    <th style="width:120px">@L("ReservedQuantity")</th>
                    <th style="width:180px">@L("LastUpdated")</th>
                    <th style="width:200px">@L("Actions")</th>
                  </tr>
                </thead>
                <tbody>
                  <!-- Dữ liệu sẽ render bằng DataTable / Ajax -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

@await Html.PartialAsync("~/Views/Inventories/_CreateInventory.cshtml", Model)


<!-- Modal Edit Inventory -->
<div class="modal fade" id="InventoryEditModal" tabindex="-1" role="dialog" aria-labelledby="InventoryEditModalLabel" data-backdrop="static">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
    </div>
  </div>
</div>
