@using MyProject.Web.Models.Common.Modals
@using MyProject.Web.Models.Products;
@using MyProject.Products.Dtos;
@using static MyProject.Products.Product
@model EditProductViewModel;

@{
	Layout = null;
}

@await Html.PartialAsync("~/Views/Shared/Modals/_ModalHeader.cshtml", new ModalHeaderViewModel(L("EditProduct")))

<form name="ProductEditForm" role="form" class="form-horizontal">
	<input type="hidden" name="Id" value="@Model.Product.Id" />



	<div class="modal-body">
		<div class="form-group row required">
			<label class="col-md-3 col-form-label" for="name">@L("ProductName")</label>
			<div class="col-md-9">
				<input id="name" type="text" class="form-control" name="Name" value="@Model.Product.Name" required maxlength="250">
			</div>
		</div>

		<div class="form-group row">
			<label class="col-md-3 col-form-label" for="description">@L("Description")</label>
			<div class="col-md-9">
				<textarea id="description" class="form-control" name="Description" rows="3">@Model.Product.Description</textarea>
			</div>
		</div>

		<div class="form-group row required">
			<label class="col-md-3 col-form-label" for="price">@L("Price")</label>
			<div class="col-md-9">
				<input id="price" type="text" class="form-control" name="Price" value="@Model.Product.Price.ToString("0")" required>
			</div>
		</div>

		<div class="form-group row required">
			<label class="col-md-3 col-form-label" for="categoryId">@L("Categories")</label>
			<div class="col-md-9">
				<select id="categoryId" class="form-control" name="CategoryId" required>
					<option value="">@L("SelectCategory")</option>
					@foreach (var category in Model.Categories)
					{
						<option value="@category.Id"
										selected="@(category.Id == Model.Product.CategoryId)">
							@category.CategoryName
						</option>
					}
				</select>
			</div>
		</div>

		<div class="form-group row">
			<label class="col-md-3 col-form-label" for="supplierId">Nhà cung cấp</label>
			<div class="col-md-9">
				<select id="supplierId" class="form-control" name="SupplierId">
					<option value="">-- Không chọn --</option>
					@if (Model.Suppliers != null)
					{
						@foreach (var supplier in Model.Suppliers)
						{
							var isSelected = Model.Product.SupplierId.HasValue && supplier.Id == Model.Product.SupplierId.Value;
							<option value="@supplier.Id" selected="@(isSelected ? "selected" : null)">
								@supplier.Name
							</option>
						}
					}
				</select>
			</div>
		</div>


		<div class="form-group row required">
			<label class="col-md-3 col-form-label" for="state">@L("State")</label>
			<div class="col-md-9">
				<select id="state" class="form-control" name="State">
					<option value="Available" selected="@(Model.Product.State == ProductState.Available)">@("Còn hàng")</option>
					<option value="OutOfStock" selected="@(Model.Product.State == ProductState.OutOfStock)">@("Hết hàng")</option>
					<option value="Discontinued" selected="@(Model.Product.State == ProductState.Discontinued)">@("Ngừng kinh doanh")</option>
				</select>
			</div>
		</div>

		<div class="form-group row">
			<label class="col-md-3 col-form-label" for="brand">Thương hiệu</label>
			<div class="col-md-9">
				<input id="brand" type="text" class="form-control" name="Brand" value="@(Model.Product.Brand ?? "")" maxlength="128" placeholder="Nhập thương hiệu/nhà sản xuất...">
			</div>
		</div>

		<div class="form-group row">
			<label class="col-md-3 col-form-label" for="weightInGrams">Khối lượng (gram)</label>
			<div class="col-md-9">
				<input id="weightInGrams" type="number" class="form-control" name="WeightInGrams" value="@(Model.Product.WeightInGrams?.ToString() ?? "")" min="0" placeholder="Nhập khối lượng (gram)...">
			</div>
		</div>

		<div class="row">
			<div class="col-md-4">
				<div class="form-group">
					<label class="col-form-label" for="widthCm">Chiều rộng (cm)</label>
					<input id="widthCm" type="number" class="form-control" name="WidthCm" value="@(Model.Product.WidthCm?.ToString("0.0") ?? "")" min="0" step="0.1" placeholder="cm">
				</div>
			</div>
			<div class="col-md-4">
				<div class="form-group">
					<label class="col-form-label" for="heightCm">Chiều cao (cm)</label>
					<input id="heightCm" type="number" class="form-control" name="HeightCm" value="@(Model.Product.HeightCm?.ToString("0.0") ?? "")" min="0" step="0.1" placeholder="cm">
				</div>
			</div>
			<div class="col-md-4">
				<div class="form-group">
					<label class="col-form-label" for="lengthCm">Chiều dài (cm)</label>
					<input id="lengthCm" type="number" class="form-control" name="LengthCm" value="@(Model.Product.LengthCm?.ToString("0.0") ?? "")" min="0" step="0.1" placeholder="cm">
				</div>
			</div>
		</div>

		<div class="form-group row">
			<label class="col-md-3 col-form-label">@L("CurrentImage")</label>
			<div class="col-md-9">
				<div class="d-flex align-items-center">
					<img id="productImage" src="@Model.Product.Image" class="img-thumbnail" style="max-width: 150px;" />
					<button type="button" id="deleteImageBtn" class="btn btn-danger ml-2"
									style="@(string.IsNullOrEmpty(Model.Product.Image) ? "display: none;" : "")">
						Xóa Ảnh
					</button>
				</div>
			</div>
		</div>

		<div class="form-group row">
			<label class="col-md-3 col-form-label" for="newImage">@L("UploadNewImage")</label>
			<div class="col-md-9">
				<input type="file" id="newImage" class="form-control" name="ImageFile" accept="image/*">
			</div>
		</div>


	</div>

	@await Html.PartialAsync("~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")
</form>

<script src="~/view-resources/Views/Products/_EditModal.js" asp-append-version="true"></script>
