<div class="abp-advanced-search p-3 bg-light border rounded">
  <form id="OrderSearchForm" class="form-horizontal">
    <div class="row align-items-end">
      <!-- Tên người dùng -->
      <div class="col-md-3 col-lg-2 mb-2 mb-md-0">
        <label for="NameUser" class="font-weight-bold mb-1">
          <i class="fas fa-user text-primary"></i> @L("NameUser")
        </label>
        <input type="text" 
               id="NameUser" 
               name="NameUser" 
               class="form-control txt-search" 
               placeholder="Nhập tên người dùng...">
      </div>

      <!-- Trạng thái đơn hàng -->
      <div class="col-md-2 col-lg-2 mb-2 mb-md-0">
        <label for="OrderStatus" class="font-weight-bold mb-1">
          <i class="fas fa-info-circle text-info"></i> @L("OrderStatus")
        </label>
        <select class="form-control" id="OrderStatus" name="OrderStatus">
          <option value="">Tất cả</option>
          <option value="0">@L("Pending")</option>
          <option value="1">@L("Confirmed")</option>
          <option value="2">@L("Shipping")</option>
          <option value="3">@L("Canceled")</option>
          <option value="4">@L("Success")</option>
        </select>
      </div>

      <!-- Phương thức thanh toán -->
      <!-- <div class="col-md-2 col-lg-2 mb-2 mb-md-0">
        <label for="PaymentMethod" class="font-weight-bold mb-1">
          <i class="fas fa-credit-card text-success"></i> @L("PaymentMethod")
        </label>
        <select class="form-control" id="PaymentMethod" name="PaymentMethod">
          <option value="">Tất cả</option>
          <option value="0">@L("BankTranfer")</option>
          <option value="1">@L("test")</option>
        </select>
      </div> -->

      <!-- Khoảng ngày - Từ ngày -->
      <div class="col-md-2 col-lg-2 mb-2 mb-md-0">
        <label for="FromDate" class="font-weight-bold mb-1">
          <i class="fas fa-calendar-alt text-warning"></i> Từ ngày
        </label>
        <input type="date" 
               id="FromDate" 
               name="FromDate" 
               class="form-control">
      </div>

      <!-- Khoảng ngày - Đến ngày -->
      <div class="col-md-2 col-lg-2 mb-2 mb-md-0">
        <label for="ToDate" class="font-weight-bold mb-1">
          <i class="fas fa-calendar-check text-danger"></i> Đến ngày
        </label>
        <input type="date" 
               id="ToDate" 
               name="ToDate" 
               class="form-control">
      </div>

      <!-- Nút tìm kiếm và reset -->
      <div class="col-md-1 col-lg-3 mb-2 mb-md-0">
        <div class="d-flex" style="gap: 8px;">
          <button type="button" class="btn bg-blue btn-search flex-fill" title="Tìm kiếm">
            <i class="fas fa-search"></i>
            <span class="d-none d-lg-inline ml-1">Tìm kiếm</span>
          </button>
          <button type="button" class="btn btn-secondary btn-reset flex-fill" title="Làm mới">
            <i class="fas fa-redo"></i>
            <span class="d-none d-lg-inline ml-1">Reset</span>
          </button>
        </div>
      </div>
    </div>
  </form>
</div>
