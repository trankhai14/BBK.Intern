@using Abp.Authorization.Users
@model MyProject.Web.Models.Account.LoginFormViewModel
@{
    ViewBag.Title = L("LogIn");
}
@section scripts
{
    <environment names="Development">
        <script src="~/view-resources/Views/Account/Login.js" asp-append-version="true"></script>
    </environment>

    <environment names="Staging,Production">
        <script src="~/view-resources/Views/Account/Login.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="login-form-container">
    <div class="login-header">
        <h2 class="login-title">@L("LogIn")</h2>
        <p class="login-subtitle">Đăng nhập vào hệ thống quản trị</p>
    </div>

    <form id="LoginForm" asp-action="Login" method="post" class="login-form" novalidate>
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <input type="hidden" name="returnUrlHash" />
        
        <div class="form-group-modern">
            <div class="input-wrapper">
                <div class="input-icon-wrapper">
                    <i class="input-icon fas fa-user"></i>
                </div>
                <input type="text" 
                       name="usernameOrEmailAddress" 
                       class="form-control-modern" 
                       placeholder="@L("UserNameOrEmail")" 
                       autofocus 
                       maxlength="@AbpUserBase.MaxEmailAddressLength"
                       data-required="true">
                <span class="error-message"></span>
            </div>
        </div>

        <div class="form-group-modern">
            <div class="input-wrapper">
                <div class="input-icon-wrapper">
                    <i class="input-icon fas fa-lock"></i>
                </div>
                <input type="password" 
                       class="form-control-modern" 
                       name="Password" 
                       autocomplete="password" 
                       placeholder="@L("Password")" 
                       maxlength="@AbpUserBase.MaxPlainPasswordLength"
                       data-required="true">
                <span class="error-message"></span>
            </div>
        </div>

        <div class="form-options">
            <div class="remember-me-wrapper">
                <label class="custom-checkbox">
                    <input type="checkbox" id="RememberMe" name="RememberMe" value="true">
                    <span class="checkmark"></span>
                    <span class="label-text">@L("RememberMe")</span>
                </label>
            </div>
        </div>

        <button type="submit" id="LoginButton" class="btn-login-modern">
            <span>@L("LogIn")</span>
            <i class="fas fa-arrow-right"></i>
        </button>
    </form>

    @if (Model.IsSelfRegistrationAllowed)
    {
        <div class="login-footer">
            <p class="register-link-text">
                Chưa có tài khoản? 
                <a asp-action="Register" class="register-link">
                    <i class="fas fa-user-plus"></i> @L("Register")
                </a>
            </p>
        </div>
    }
</div>
