@using MyProject.Web.Views.Shared.Components.HeaderMenu
@model HeaderMenuViewModel

@if (Model.LoginInformations.User == null)
{
	<li class="nav-item">
		<div class="auth-links d-flex align-items-center">
			<a class="nav-link-modern auth-link-modern register" href="/Account/Register">
				<i class="fas fa-user-plus"></i>
				<span>Đăng ký</span>
			</a>
			<a class="nav-link-modern auth-link-modern" href="/Account/Login">
				<i class="fas fa-sign-in-alt"></i>
				<span>Đăng nhập</span>
			</a>
		</div>
	</li>
}
else
{
	<li class="nav-item dropdown user-dropdown-modern">
		<a class="nav-link-modern dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
			<img src="~/libs/admin-lte/dist/img/avatar5.png" class="user-avatar" alt="User Image">
			<span class="user-name ml-2">@Html.Raw(Model.GetShownLoginName())</span>
		</a>
		<ul class="dropdown-menu dropdown-menu-modern dropdown-menu-right" aria-labelledby="userDropdown">
			<li>
				<a class="dropdown-item-modern" href="/Home/UserProfile">
					<i class="fas fa-user"></i>
					<span>Thông tin tài khoản</span>
				</a>
			</li>
			<li>
				<a class="dropdown-item-modern logout" href="/Account/Logout">
					<i class="fas fa-sign-out-alt"></i>
					<span>Đăng xuất</span>
				</a>
			</li>
		</ul>
	</li>
}



