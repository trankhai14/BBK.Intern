@* @using MyProject.Web.Mvc.Frontend.Views.Shared.Components.HeaderMenu *@
@using MyProject.Web.Views.Shared.Components.CartMenu
@using MyProject.Web.Views.Shared.Components.CategoryMenu
@using MyProject.Web.Views.Shared.Components.HeaderMenu

<link href="~/css/header.css" rel="stylesheet" asp-append-version="true" />

<!-- Thanh điều hướng chính -->
<nav class="navbar navbar-expand-lg navbar-main">
	<div class="container">
		<!-- Logo -->
		<a class="navbar-brand fw-bold d-flex align-items-center" href="/">
			<i class="fas fa-store"></i>
			<span>Shop Điện Tử</span>
		</a>

		<!-- Toggle button cho mobile -->
		<button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
			<span class="navbar-toggler-icon"></span>
		</button>

		<!-- Nội dung Navbar -->
		<div class="collapse navbar-collapse" id="navbarNav">
			<!-- Ô tìm kiếm ở giữa -->
			<form id="searchForm" class="search-container" style="flex: 1; max-width: 500px; margin: 0 auto;">
				<div class="search-wrapper">
					<input id="searchInput" 
						   name="Keyword" 
						   class="search-input" 
						   type="text" 
						   placeholder="Tìm kiếm sản phẩm...">
					<button class="btn-search-modern" type="submit" aria-label="Tìm kiếm">
						<i class="fas fa-search"></i>
					</button>
				</div>
			</form>

			<!-- Giỏ hàng & Đăng nhập bên phải -->
			<ul class="navbar-nav ml-auto align-items-center">
				<li class="nav-item">
					@await Component.InvokeAsync(typeof(CartMenuViewComponent))
				</li>
				<li class="nav-item">
					@await Component.InvokeAsync(typeof(HeaderMenuViewComponent))
				</li>
			</ul>
		</div>
	</div>
</nav>

<!-- Menu danh mục -->
<nav class="category-menu-modern">
	<div class="container">
		<ul class="navbar-nav d-flex flex-row justify-content-center flex-wrap">
			@await Component.InvokeAsync(typeof(CategoryMenuViewComponent))
		</ul>
	</div>
</nav>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script src="~/view-resources/Views/Home/index.js" asp-append-version="true"></script>
