@using MyProject.Carts
@using MyProject.Web.Models.Carts
@model CartViewListModel
@{
	ViewData["Title"] = "Giỏ hàng";
}

<link href="/css/cart.css" rel="stylesheet" asp-append-version="true" />

@section scripts
{
	<environment names="Development">
		<script src="~/view-resources/Views/Carts/Index.js" asp-append-version="true"></script>
	</environment>

	<environment names="Staging,Production">
		@* <script src="~/view-resources/Views/Carts/Index.min.js" asp-append-version="true"></script> *@
	</environment>
}

<div class="cart-page-container">
	@if (Model == null || Model.Carts == null || !Model.Carts.Any())
	{
		<!-- Phần hiển thị giỏ hàng trống -->
		<main class="empty-cart-container">
			<div class="empty-cart-content">
				<!-- Hình ảnh giỏ hàng trống -->
				<img src="https://cdn-icons-png.flaticon.com/512/2038/2038854.png"
					 alt="Empty Cart" class="mb-3">

				<!-- Tiêu đề và nội dung -->
				<h4>Giỏ hàng trống</h4>
				<p>Không có sản phẩm nào trong giỏ hàng của bạn.</p>

				<!-- Nút quay về trang chủ -->
				<a href="/" class="btn btn-primary">
					🛒 Tiếp tục mua sắm
				</a>

				<!-- Hỗ trợ khách hàng -->
				<p class="text-secondary">
					Cần trợ giúp? Gọi ngay
					<a href="tel:1900232460">1900 232 460</a>
					hoặc <a href="tel:02836221060">028.3622.1060</a> (8h00 - 21h30)
				</p>
			</div>
		</main>

		<!-- Tự động chuyển hướng về trang chủ sau 10 giây -->
		<script>
			setTimeout(function () {
				window.location.href = "/";
			}, 10000);
		</script>
	}
	else
	{
		<!-- Tiêu đề giỏ hàng -->
		<div class="cart-header">
			<h2>
				<i class="fas fa-shopping-cart"></i>
				Giỏ hàng của tôi
			</h2>
			<span class="cart-item-count">(@Model.Carts.Count sản phẩm)</span>
		</div>

		<div class="row">
			<!-- Cột trái: Danh sách sản phẩm -->
			<div class="col-lg-8 col-md-12">
				<div class="cart-items-list">
					@foreach (var item in Model.Carts)
					{
						<div class="cart-item">
							<!-- Ảnh sản phẩm -->
							<div class="cart-item-image">
								<img src="@(string.IsNullOrEmpty(item.Image) ? "/img/default.jpg" : item.Image)" 
									 alt="@item.Name">
							</div>

							<!-- Thông tin sản phẩm -->
							<div class="cart-item-info">
								<h5 class="cart-item-name">@item.Name</h5>
								@if (!string.IsNullOrEmpty(item.Description))
								{
									<p class="cart-item-description">@item.Description</p>
								}

								<!-- Chọn khuyến mãi -->
								<div class="cart-item-promo">
									<p class="cart-item-promo-title">Chọn 1 trong 2 khuyến mãi</p>
									<div class="cart-item-promo-options">
										<div class="cart-item-promo-option">
											<input type="radio" name="promo-@item.Id" id="promo1-@item.Id">
											<label for="promo1-@item.Id">Giảm ngay 700,000đ</label>
										</div>
										<div class="cart-item-promo-option">
											<input type="radio" name="promo-@item.Id" id="promo2-@item.Id">
											<label for="promo2-@item.Id">Tặng Microsoft 365 Personal</label>
										</div>
									</div>
									<a href="#" class="cart-item-promo-more">5 Khuyến mãi khác <i class="fas fa-chevron-down"></i></a>
								</div>
							</div>

							<!-- Phần điều khiển (số lượng, giá, xóa) -->
							<div class="cart-item-controls">
								<!-- Nút xóa -->
								<button data-id="@item.Id" class="cart-item-delete btn-delete" type="button">
									<i class="fas fa-trash-alt"></i>
									<span>Xóa</span>
								</button>

								<!-- Điều khiển số lượng -->
								<div class="cart-item-quantity">
									<button class="btn-reduce" data-id="@item.Id" type="button">-</button>
									<input data-id="@item.Id" 
										   type="text" 
										   class="quantity-input" 
										   value="@item.Quantity"
										   readonly>
									<button class="btn-increase" data-id="@item.Id" type="button">+</button>
								</div>

								<!-- Giá sản phẩm -->
								<span data-unit-price="@item.Price.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" class="product-price cart-item-price">
									@String.Format("{0:N0} đ", item.TotalPrice)
								</span>
							</div>
						</div>
					}
				</div>
			</div>

			<!-- Cột phải: Tổng tiền và thanh toán -->
			<div class="col-lg-4 col-md-12">
				<!-- Tổng tiền -->
				<div class="cart-summary">
					<div class="cart-summary-row">
						<span class="cart-summary-label">Tạm tính:</span>
						<span class="cart-summary-value" id="subTotalPrice"></span>
					</div>
					<div class="cart-summary-row">
						<span class="cart-summary-label">Phí vận chuyển:</span>
						<span class="cart-summary-value">Miễn phí</span>
					</div>
					<div class="cart-summary-row">
						<span class="cart-summary-label">Tổng cộng:</span>
						<span class="cart-summary-value" id="totalPrice"></span>
					</div>
				</div>

				<!-- Phương thức thanh toán -->
				<div class="cart-payment">
					<h5 class="cart-payment-title">
						<i class="fas fa-credit-card"></i>
						Hình thức thanh toán
					</h5>
					<div class="cart-payment-options">
						<div class="cart-payment-option">
							<input type="radio" name="paymentMethod" id="cod" value="cod" checked>
							<label for="cod">
								<i class="fas fa-money-bill-wave text-success"></i>
								Thanh toán tiền mặt khi nhận hàng
							</label>
						</div>
						<div class="cart-payment-option">
							<input type="radio" name="paymentMethod" id="bankTransfer" value="bankTransfer">
							<label for="bankTransfer">
								<i class="fas fa-university text-primary"></i>
								Chuyển khoản ngân hàng
							</label>
						</div>
					</div>

					<!-- Bootstrap collapse với icon mũi tên -->
					<a href="#paymentMethods" 
					   data-toggle="collapse" 
					   class="cart-payment-more"
					   aria-expanded="false">
						5 hình thức thanh toán khác <i class="fas fa-chevron-down"></i>
					</a>

					<!-- Danh sách ẩn -->
					<div class="collapse cart-payment-collapse" id="paymentMethods">
						<div class="cart-payment-options">
							<div class="cart-payment-option">
								<input type="radio" name="paymentMethod" id="momo" value="momo">
								<label for="momo">
									<i class="fas fa-mobile-alt text-danger"></i>
									Thanh toán qua Momo
								</label>
							</div>
							<div class="cart-payment-option">
								<input type="radio" name="paymentMethod" id="creditCard" value="creditCard">
								<label for="creditCard">
									<i class="fas fa-credit-card text-info"></i>
									Thanh toán bằng thẻ tín dụng
								</label>
							</div>
							<div class="cart-payment-option">
								<input type="radio" name="paymentMethod" id="zalopay" value="zalopay">
								<label for="zalopay">
									<i class="fas fa-wallet text-primary"></i>
									Ví ZaloPay
								</label>
							</div>
						</div>
					</div>

					<!-- Chính sách -->
					<div class="cart-policy">
						<div class="cart-policy-checkbox">
							<input type="checkbox" id="agreePolicy" checked>
							<label for="agreePolicy">
								Tôi đồng ý với <a href="#">Chính sách xử lý dữ liệu cá nhân</a> của Thế Giới Di Động
							</label>
						</div>
					</div>

					<!-- Nút đặt hàng -->
					<button id="btnCheckout" 
							data-userId="@Model.UserId" 
							data-nameUser="@Model.NameUser" 
							class="cart-checkout-btn">
						<i class="fas fa-shopping-bag me-2"></i>
						Đặt hàng ngay
					</button>
				</div>
			</div>
		</div>
	}
</div>

<!-- Modal Xác Nhận Xóa -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" role="dialog" aria-labelledby="confirmDeleteLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="confirmDeleteLabel">
					<i class="fas fa-exclamation-triangle text-warning mr-2"></i>
					Xác nhận xóa sản phẩm
				</h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<div class="modal-body">
				<p class="mb-0">Bạn có chắc chắn muốn xóa sản phẩm này khỏi giỏ hàng không?</p>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" id="confirmCancelBtn" data-dismiss="modal">
					<i class="fas fa-times mr-2"></i>Hủy
				</button>
				<button type="button" class="btn btn-danger" id="confirmDeleteBtn">
					<i class="fas fa-trash-alt mr-2"></i>Xóa
				</button>
			</div>
		</div>
	</div>
</div>
