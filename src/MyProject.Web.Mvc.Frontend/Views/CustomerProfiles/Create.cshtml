@using MyProject.CustomerProfiles.Dto
@model CreateCustomerProfileDto
@{
	ViewData["Title"] = "Thêm thông tin khách hàng";
}

<div class="container mt-4" style="max-width: 800px;">
	<div class="card">
		<div class="card-header">
			<h4><i class="fas fa-plus-circle"></i> Thêm thông tin khách hàng</h4>
		</div>
		<div class="card-body">
			<form asp-action="Create" method="post" enctype="multipart/form-data">
				<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

				<div class="mb-3 text-center">
					<label class="form-label">Ảnh đại diện</label>
					<div class="mb-2">
						<img id="avatarPreview" src="/img/default-avatar.png" alt="Avatar Preview" class="rounded-circle" style="width: 150px; height: 150px; object-fit: cover; border: 2px solid #dee2e6; cursor: pointer;" onclick="document.getElementById('AvatarFile').click()">
					</div>
					<input type="file" asp-for="AvatarFile" id="AvatarFile" accept="image/*" class="form-control d-none" onchange="previewAvatar(this)" />
					<small class="text-muted d-block">Chọn ảnh (JPG, PNG, GIF - tối đa 5MB)</small>
					<span asp-validation-for="AvatarFile" class="text-danger"></span>
				</div>

				<div class="mb-3">
					<label asp-for="FullName" class="form-label">Họ và tên <span class="text-danger">*</span></label>
					<input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên" />
					<span asp-validation-for="FullName" class="text-danger"></span>
				</div>

				<div class="mb-3">
					<label asp-for="PhoneNumber" class="form-label">Số điện thoại <span class="text-danger">*</span></label>
					<input asp-for="PhoneNumber" class="form-control" placeholder="Nhập số điện thoại" />
					<span asp-validation-for="PhoneNumber" class="text-danger"></span>
				</div>

				<div class="mb-3">
					<label asp-for="Address" class="form-label">Địa chỉ <span class="text-danger">*</span></label>
					<input asp-for="Address" class="form-control" placeholder="Nhập địa chỉ chi tiết" />
					<span asp-validation-for="Address" class="text-danger"></span>
				</div>

				<div class="row">
					<div class="col-md-4 mb-3">
						<label asp-for="Ward" class="form-label">Phường/Xã</label>
						<input asp-for="Ward" class="form-control" placeholder="Nhập phường/xã" />
						<span asp-validation-for="Ward" class="text-danger"></span>
					</div>

					<div class="col-md-4 mb-3">
						<label asp-for="District" class="form-label">Quận/Huyện</label>
						<input asp-for="District" class="form-control" placeholder="Nhập quận/huyện" />
						<span asp-validation-for="District" class="text-danger"></span>
					</div>

					<div class="col-md-4 mb-3">
						<label asp-for="City" class="form-label">Tỉnh/Thành phố <span class="text-danger">*</span></label>
						<input asp-for="City" class="form-control" placeholder="Nhập tỉnh/thành phố" />
						<span asp-validation-for="City" class="text-danger"></span>
					</div>
				</div>

				<div class="mb-3 form-check">
					<input asp-for="IsDefault" class="form-check-input" type="checkbox" />
					<label asp-for="IsDefault" class="form-check-label">
						Đặt làm địa chỉ mặc định
					</label>
				</div>

				<div class="d-flex justify-content-between">
					<a href="@Url.Action("Index")" class="btn btn-secondary">
						<i class="fas fa-arrow-left"></i> Quay lại
					</a>
					<button type="submit" class="btn btn-primary">
						<i class="fas fa-save"></i> Lưu thông tin
					</button>
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
	<script>
		function previewAvatar(input) {
			if (input.files && input.files[0]) {
				var reader = new FileReader();
				reader.onload = function (e) {
					document.getElementById('avatarPreview').src = e.target.result;
				};
				reader.readAsDataURL(input.files[0]);
			}
		}
	</script>
}

