@using MyProject.Web.Models.Products
@using MyProject.Product.Dtos
@using MyProject.FlashSales.Dto
@using static MyProject.Products.Product
@model DetailProductModel

@section scripts
{
	<environment names="Development">
		<script src="~/view-resources/Views/Carts/Index.js" asp-append-version="true"></script>
		<script src="~/view-resources/Views/Home/Index.js" asp-append-version="true"></script>
	</environment>

	<environment names="Staging,Production">
		@* <script src="~/view-resources/Views/Carts/Index.min.js" asp-append-version="true"></script> *@
	</environment>
}

<link href="/css/homeweb.css" rel="stylesheet" asp-append-version="true" />
<link href="/css/detailproduct.css" rel="stylesheet" asp-append-version="true" />
<link href="/css/flashsale.css" rel="stylesheet" asp-append-version="true" />

<div class="container mt-3" style="max-width: 960px;">
	<!-- Breadcrumb -->
	<nav aria-label="breadcrumb" class="breadcrumb-modern">
		<ol class="breadcrumb mb-2">
			<li class="breadcrumb-item"><a href="/Home">Trang chủ</a></li>
			<li class="breadcrumb-item"><a href="/Home/PageAllProduct?categoryId=@Model.CategoryId">@Model.CategoryName</a></li>
			<li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
		</ol>
	</nav>

	<!-- Thông tin sản phẩm chính -->
	<div class="product-detail-container">
		<div class="row">
			<!-- Hình ảnh sản phẩm -->
			<div class="col-md-5">
				<div class="text-center">
					<img src="@(string.IsNullOrEmpty(Model.Image) ? "/img/default.jpg" : Model.Image)" 
						 class="product-image-main-detail" 
						 alt="@Model.Name">
				</div>
			</div>

			<!-- Thông tin sản phẩm -->
			<div class="col-md-7 product-info-section">
				<!-- FlashSale Badge -->
				@if (Model.FlashSaleProduct != null)
				{
					<div class="mb-2">
						<span class="badge bg-danger" style="font-size: 14px; padding: 8px 15px;">
							<i class="fas fa-bolt"></i> FLASHSALE
						</span>
					</div>
				}

				<!-- Tên sản phẩm -->
				<h1 class="product-title-detail">@Model.Name</h1>

				<!-- Giá sản phẩm -->
				<div class="product-price-section">
					@if (Model.FlashSaleProduct != null)
					{
						<!-- FlashSale Price -->
						<span class="product-price-current" style="color: #d70018; font-size: 28px;">
							@String.Format("{0:N0}", Model.FlashSaleProduct.FlashSalePrice) đ
						</span>
						<span class="product-price-old" style="font-size: 18px; margin-left: 10px;">
							@String.Format("{0:N0}", Model.FlashSaleProduct.OriginalPrice) đ
						</span>
						@* @{ *@
							var discountPercent = Model.FlashSaleProduct.OriginalPrice > 0 
								? ((Model.FlashSaleProduct.OriginalPrice - Model.FlashSaleProduct.FlashSalePrice) / Model.FlashSaleProduct.OriginalPrice) * 100 
								: 0;
						// }
						<div class="mt-2">
							<span class="badge bg-danger" style="font-size: 14px;">
								Giảm @Math.Round(discountPercent, 0)%
							</span>
						</div>
					}
					else
					{
						<!-- Normal Price -->
					<span class="product-price-current">@String.Format("{0:N0}", Model.Price) đ</span>
					@if (Model.Price < 20000000)
					{
						<span class="product-price-old">@String.Format("{0:N0}", Model.Price * 1.2m) đ</span>
						}
					}
					<div class="mt-2">
						@if (Model.State == ProductState.Available)
						{
							<span class="product-badge-status badge-available">Còn hàng</span>
						}
						else if (Model.State == ProductState.OutOfStock)
						{
							<span class="product-badge-status badge-outofstock">Hết hàng</span>
						}
						else
						{
							<span class="product-badge-status badge-discontinued">Ngừng kinh doanh</span>
						}
						<span class="badge bg-warning text-dark">Trả góp 0%</span>
					</div>
				</div>

				<!-- FlashSale Info -->
				@if (Model.FlashSaleProduct != null)
				{
					<div class="flashsale-info-detail mt-3 mb-3 p-3" style="background: #fff3cd; border-radius: 8px; border: 1px solid #ffc107;">
						<h5 style="color: #d70018; margin-bottom: 10px;">
							<i class="fas fa-fire"></i> Thông tin FlashSale
						</h5>
						<div class="row">
							<div class="col-md-6">
								<p style="margin-bottom: 5px;">
									<strong>Số lượng còn lại:</strong> 
									<span class="badge bg-warning">@Model.FlashSaleProduct.RemainingQuantity sản phẩm</span>
								</p>
								<p style="margin-bottom: 5px;">
									<strong>Đã bán:</strong> @Model.FlashSaleProduct.SoldQuantity/@Model.FlashSaleProduct.FlashSaleQuantity
								</p>
								@if (Model.FlashSaleProduct.MaxQuantityPerUser.HasValue)
								{
									<p style="margin-bottom: 5px;">
										<strong>Giới hạn mua:</strong> @Model.FlashSaleProduct.MaxQuantityPerUser sản phẩm/người
									</p>
								}
							</div>
							<div class="col-md-6">
								@{
									var soldPercent = Model.FlashSaleProduct.FlashSaleQuantity > 0 
										? ((decimal)Model.FlashSaleProduct.SoldQuantity / Model.FlashSaleProduct.FlashSaleQuantity) * 100 
										: 0;
								}
								<div class="progress" style="height: 20px; margin-top: 10px;">
									<div class="progress-bar progress-bar-danger" role="progressbar" 
										 style="width: @Math.Round(soldPercent, 0)%" 
										 aria-valuenow="@Model.FlashSaleProduct.SoldQuantity" 
										 aria-valuemin="0" 
										 aria-valuemax="@Model.FlashSaleProduct.FlashSaleQuantity">
										@Math.Round(soldPercent, 0)%
									</div>
								</div>
							</div>
						</div>
					</div>
				}

				<!-- Mô tả ngắn -->
				@if (!string.IsNullOrEmpty(Model.Description))
				{
					<div class="mt-2">
						<p style="color: #4a5568; line-height: 1.5; font-size: 14px; margin-bottom: 0;">@Model.Description</p>
					</div>
				}

				<!-- Khuyến mãi -->
				<div class="promo-box">
					<h5 style="font-size: 16px; margin-bottom: 8px;"><i class="fas fa-gift"></i> Khuyến mãi đặc biệt</h5>
					<ul class="promo-list">
						<li>Giảm ngay 700.000đ khi mua online</li>
						<li>Tặng kèm phụ kiện cao cấp</li>
						<li>Bảo hành chính hãng 12 tháng</li>
						<li>Miễn phí vận chuyển toàn quốc</li>
					</ul>
				</div>

				<!-- Số lượng -->
				<div class="quantity-input-group">
					<label>Số lượng:</label>
					@if (Model.FlashSaleProduct != null)
					{
						var maxQuantity = Model.FlashSaleProduct.MaxQuantityPerUser.HasValue 
							? Math.Min(Model.FlashSaleProduct.MaxQuantityPerUser.Value, Model.FlashSaleProduct.RemainingQuantity) 
							: Model.FlashSaleProduct.RemainingQuantity;
						<input id="quantity-add-detail" 
							   type="number" 
							   class="form-control" 
							   value="1" 
							   min="1" 
							   max="@maxQuantity"
							   data-flashsale-product-id="@Model.FlashSaleProduct.Id"
							   data-flashsale-max-quantity="@maxQuantity"
							   data-flashsale-remaining="@Model.FlashSaleProduct.RemainingQuantity">
						<small class="form-text text-muted">
							Tối đa: @maxQuantity sản phẩm
							@if (Model.FlashSaleProduct.MaxQuantityPerUser.HasValue)
							{
								<span>(Giới hạn: @Model.FlashSaleProduct.MaxQuantityPerUser sản phẩm/người)</span>
							}
						</small>
					}
					else
					{
					<input id="quantity-add-detail" type="number" class="form-control" value="1" min="1" max="99">
					}
				</div>

				<!-- Nút hành động -->
				<div class="btn-action-group">
					@if (Model.FlashSaleProduct != null)
					{
						<button data-Id="@Model.Id" 
								class="btn btn-add-cart btn-add-detail"
								data-flashsale-product-id="@Model.FlashSaleProduct.Id"
								style="background: #d70018; border-color: #d70018; color: white;">
							<i class="fas fa-shopping-cart"></i> Thêm vào giỏ hàng FlashSale
						</button>
						<button class="btn btn-buy-now" style="background: #ff4444; border-color: #ff4444; color: white;">
							<i class="fas fa-bolt"></i> Mua ngay FlashSale
						</button>
					}
					else
					{
					<button data-Id="@Model.Id" class="btn btn-add-cart btn-add-detail">
						<i class="fas fa-shopping-cart"></i> Thêm vào giỏ hàng
					</button>
					<button class="btn btn-buy-now">
						<i class="fas fa-bolt"></i> Mua ngay
					</button>
					}
				</div>
			</div>
		</div>
	</div>

	<!-- Thông số kỹ thuật -->
	<div class="product-detail-container">
		<h3 class="mb-3" style="font-weight: 700; color: #1d2939; border-bottom: 2px solid #d70018; padding-bottom: 8px; font-size: 20px;">
			<i class="fas fa-info-circle"></i> Thông số kỹ thuật
		</h3>
		<table class="specs-table">
			<tbody>
				<tr>
					<td>Tên sản phẩm</td>
					<td>@Model.Name</td>
				</tr>
				@if (!string.IsNullOrEmpty(Model.Brand))
				{
					<tr>
						<td>Thương hiệu</td>
						<td>@Model.Brand</td>
					</tr>
				}
				<tr>
					<td>Danh mục</td>
					<td>@Model.CategoryName</td>
				</tr>
				<tr>
					<td>Giá bán</td>
					<td>
						@if (Model.FlashSaleProduct != null)
						{
							<strong style="color: #d70018;">@String.Format("{0:N0}", Model.FlashSaleProduct.FlashSalePrice) đ</strong>
							<span style="text-decoration: line-through; color: #999; margin-left: 10px;">
								@String.Format("{0:N0}", Model.FlashSaleProduct.OriginalPrice) đ
							</span>
							<span class="badge bg-danger ml-2">FlashSale</span>
						}
						else
						{
							<strong style="color: #d70018;">@String.Format("{0:N0}", Model.Price) đ</strong>
						}
					</td>
				</tr>
				<tr>
					<td>Tình trạng</td>
					<td>
						@if (Model.State == ProductState.Available)
						{
							<span class="product-badge-status badge-available">Còn hàng</span>
						}
						else if (Model.State == ProductState.OutOfStock)
						{
							<span class="product-badge-status badge-outofstock">Hết hàng</span>
						}
						else
						{
							<span class="product-badge-status badge-discontinued">Ngừng kinh doanh</span>
						}
					</td>
				</tr>
				@if (Model.WeightInGrams.HasValue)
				{
					<tr>
						<td>Trọng lượng</td>
						<td>@Model.WeightInGrams.Value g (@String.Format("{0:F2}", Model.WeightInGrams.Value / 1000.0) kg)</td>
					</tr>
				}
				@if (Model.WidthCm.HasValue || Model.HeightCm.HasValue || Model.LengthCm.HasValue)
				{
					<tr>
						<td>Kích thước</td>
						<td>
							@if (Model.LengthCm.HasValue && Model.WidthCm.HasValue && Model.HeightCm.HasValue)
							{
								<span>@Model.LengthCm.Value cm × @Model.WidthCm.Value cm × @Model.HeightCm.Value cm</span>
							}
							else
							{
								<span>
									@if (Model.LengthCm.HasValue) { <span>Dài: @Model.LengthCm.Value cm</span> }
									@if (Model.WidthCm.HasValue) { <span>Rộng: @Model.WidthCm.Value cm</span> }
									@if (Model.HeightCm.HasValue) { <span>Cao: @Model.HeightCm.Value cm</span> }
								</span>
							}
						</td>
					</tr>
				}
				
				<!-- Thông tin kỹ thuật điện thoại -->
				@if (!string.IsNullOrEmpty(Model.Sku))
				{
					<tr>
						<td>Mã SKU</td>
						<td>@Model.Sku</td>
					</tr>
				}
				@if (!string.IsNullOrEmpty(Model.ModelNumber))
				{
					<tr>
						<td>Số model</td>
						<td><strong>@Model.ModelNumber</strong></td>
					</tr>
				}
				@if (!string.IsNullOrEmpty(Model.Chipset))
				{
					<tr>
						<td>Chip xử lý</td>
						<td>@Model.Chipset</td>
					</tr>
				}
				@if (!string.IsNullOrEmpty(Model.Ram))
				{
					<tr>
						<td>RAM</td>
						<td>@Model.Ram</td>
					</tr>
				}
				@if (!string.IsNullOrEmpty(Model.Storage))
				{
					<tr>
						<td>Bộ nhớ trong</td>
						<td>@Model.Storage</td>
					</tr>
				}
				@if (!string.IsNullOrEmpty(Model.Screen))
				{
					<tr>
						<td>Màn hình</td>
						<td>@Model.Screen</td>
					</tr>
				}
				@if (!string.IsNullOrEmpty(Model.OperatingSystem))
				{
					<tr>
						<td>Hệ điều hành</td>
						<td>@Model.OperatingSystem</td>
					</tr>
				}
				@if (!string.IsNullOrEmpty(Model.Battery))
				{
					<tr>
						<td>Dung lượng pin</td>
						<td>@Model.Battery</td>
					</tr>
				}
				@if (!string.IsNullOrEmpty(Model.Camera))
				{
					<tr>
						<td>Camera sau</td>
						<td>@Model.Camera</td>
					</tr>
				}
				@if (!string.IsNullOrEmpty(Model.FrontCamera))
				{
					<tr>
						<td>Camera trước</td>
						<td>@Model.FrontCamera</td>
					</tr>
				}
				@if (!string.IsNullOrEmpty(Model.Sim))
				{
					<tr>
						<td>Thông tin SIM</td>
						<td>@Model.Sim</td>
					</tr>
				}
				@if (!string.IsNullOrEmpty(Model.Connectivity))
				{
					<tr>
						<td>Kết nối</td>
						<td>@Model.Connectivity</td>
					</tr>
				}
				@if (!string.IsNullOrEmpty(Model.Security))
				{
					<tr>
						<td>Bảo mật</td>
						<td>@Model.Security</td>
					</tr>
				}
				@if (!string.IsNullOrEmpty(Model.Charging))
				{
					<tr>
						<td>Sạc nhanh</td>
						<td>@Model.Charging</td>
					</tr>
				}
				@if (!string.IsNullOrEmpty(Model.ChargingPort))
				{
					<tr>
						<td>Cổng sạc</td>
						<td>@Model.ChargingPort</td>
					</tr>
				}
				@if (!string.IsNullOrEmpty(Model.Color))
				{
					<tr>
						<td>Màu sắc</td>
						<td>@Model.Color</td>
					</tr>
				}
				@if (!string.IsNullOrEmpty(Model.Warranty))
				{
					<tr>
						<td>Bảo hành</td>
						<td><strong>@Model.Warranty</strong></td>
					</tr>
				}
				@if (!string.IsNullOrEmpty(Model.TechnicalSpecifications))
				{
					<tr>
						<td>Thông tin kỹ thuật khác</td>
						<td>
							<div style="white-space: pre-line; line-height: 1.6;">@Model.TechnicalSpecifications</div>
						</td>
					</tr>
				}
				
				<tr>
					<td>Ngày thêm</td>
					<td>@Model.CreationTime.ToString("dd/MM/yyyy")</td>
				</tr>
			</tbody>
		</table>
	</div>

	<!-- Đánh giá khách hàng -->
	<div class="product-detail-container">
		<h3 class="mb-3" style="font-weight: 700; color: #1d2939; border-bottom: 2px solid #d70018; padding-bottom: 8px; font-size: 20px;">
			<i class="fas fa-star"></i> Đánh giá sản phẩm
		</h3>
		<div class="rating-section mb-2">
			<div class="rating-stars">
				<i class="fas fa-star"></i>
				<i class="fas fa-star"></i>
				<i class="fas fa-star"></i>
				<i class="fas fa-star"></i>
				<i class="far fa-star"></i>
			</div>
			<span class="rating-text">4.0/5 (128 đánh giá)</span>
		</div>
		<textarea class="form-control mt-2" rows="3" placeholder="Chia sẻ đánh giá của bạn về sản phẩm này..." style="font-size: 14px;"></textarea>
		<button class="btn btn-success mt-2" style="font-size: 14px; padding: 8px 16px;">
			<i class="fas fa-paper-plane"></i> Gửi đánh giá
		</button>
	</div>

	<!-- Sản phẩm tương tự -->
	@if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
	{
		<div class="related-products-section">
			<h3 class="related-products-title" style="font-size: 20px; margin-bottom: 15px;">
				<i class="fas fa-th"></i> Sản phẩm tương tự
			</h3>
			<div class="related-products-container">
				@foreach (var product in Model.RelatedProducts)
				{
					<div class="related-product-item">
						<div class="product-card-modern">
							<div class="card product-card-wrapper">
								<!-- Phần hình ảnh sản phẩm -->
								<div class="product-image-wrapper">
									<img data-id="@product.Id" 
										 class="product-image-main btn-view-detail" 
										 src="@(string.IsNullOrEmpty(product.Image) ? "/img/default.jpg" : product.Image)" 
										 alt="@product.Name">
									<!-- Badge giảm giá -->
									<div class="product-badge">-10%</div>
									<!-- Nút yêu thích -->
									<button class="product-favorite-btn" type="button">
										<i class="far fa-heart"></i>
									</button>
								</div>
								
								<!-- Phần thông tin sản phẩm -->
								<div class="card-body product-info">
									<!-- Tên sản phẩm -->
									<h5 class="product-title btn-view-detail" data-id="@product.Id">@product.Name</h5>
									
									<!-- Đánh giá sao -->
									<div class="product-rating-modern">
										<div class="stars">
											<i class="fas fa-star"></i>
											<i class="fas fa-star"></i>
											<i class="fas fa-star"></i>
											<i class="fas fa-star"></i>
											<i class="fas fa-star"></i>
										</div>
										<span class="rating-text">(128)</span>
									</div>
									
									<!-- Giá sản phẩm -->
									<div class="product-price-section" style="margin-top: 8px; margin-bottom: 8px;">
										<span class="product-price-current" style="font-size: 15px; font-weight: 600; color: #d70018;">@String.Format("{0:N0}", product.Price) đ</span>
										@if (product.Price < 20000000)
										{
											<span class="product-price-old" style="font-size: 12px; color: #999; text-decoration: line-through; margin-left: 6px;">@String.Format("{0:N0}", product.Price * 1.2m) đ</span>
										}
									</div>
									
									<!-- Thông tin khuyến mãi -->
									<div class="product-promo">
										<i class="fas fa-gift"></i>
										<span>Smember giảm thêm đến <strong>10%</strong></span>
									</div>
								</div>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	}
</div>
