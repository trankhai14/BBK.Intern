@using MyProject.Web.Models.Orders
@model FilterStatusOrderViewModel

@* Link CSS file *@
<link href="/css/order-list.css" rel="stylesheet" />

@* ============================================
   ORDER LIST CONTAINER
   ============================================ *@

@* Filter Container - Chứa tiêu đề và các nút lọc theo trạng thái *@
<div class="order-filter-container">
	@* Tiêu đề section *@
	<div class="order-title-section">
		<h4><i class="fas fa-shopping-bag"></i> Đơn hàng đã mua</h4>
	</div>

	@* Filter Buttons - Lọc đơn hàng theo trạng thái *@
	<div class="order-filter-buttons">
		@* Button: Tất cả đơn hàng (status = 5) *@
		<a href="#" data-status="5" class="btn-status-filter btn-status active">
			<i class="fas fa-list"></i> Tất cả
		</a>
		@* Button: Chờ xử lý (status = 0) *@
		<a href="#" data-status="0" class="btn-status-filter btn-status">
			<i class="fas fa-clock"></i> Chờ xử lý
		</a>
		@* Button: Đã xác nhận (status = 1) *@
		<a href="#" data-status="1" class="btn-status-filter btn-status">
			<i class="fas fa-check-circle"></i> Đã xác nhận
		</a>
		@* Button: Đang giao hàng (status = 2) *@
		<a href="#" data-status="2" class="btn-status-filter btn-status">
			<i class="fas fa-truck"></i> Đang giao hàng
		</a>
		@* Button: Đã hủy (status = 3) *@
		<a href="#" data-status="3" class="btn-status-filter btn-status">
			<i class="fas fa-times-circle"></i> Đã hủy
		</a>
		@* Button: Hoàn thành (status = 4) *@
		<a href="#" data-status="4" class="btn-status-filter btn-status">
			<i class="fas fa-check-double"></i> Hoàn thành
		</a>
	</div>
</div>

@* Container chứa danh sách đơn hàng (sẽ được load động qua AJAX) *@
<div id="orderList">
	@await Html.PartialAsync("FilterOrder", Model)
</div>




