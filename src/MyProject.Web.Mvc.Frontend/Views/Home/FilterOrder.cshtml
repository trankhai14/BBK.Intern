@{
	// Lấy danh sách đơn hàng từ model
	var orders = Model?.ListOrder as List<MyProject.OrderDetails.Dto.OrderDetailDto> ?? new List<MyProject.OrderDetails.Dto.OrderDetailDto>();
	// Lấy danh sách sản phẩm từ model
	var productsList = Model?.Products as List<MyProject.Product.Dtos.ProductListDto> ?? new List<MyProject.Product.Dtos.ProductListDto>();
}

@* Link CSS file *@
<link href="/css/filter-order.css" rel="stylesheet" />

@* ============================================
   FILTER ORDER - Danh sách đơn hàng
   ============================================ *@
<div style="overflow-y: auto">
	@* Kiểm tra xem có đơn hàng nào không *@
	@if (orders.Any())
	{
		@* Nhóm các order items theo OrderId *@
		@foreach (var orderGroup in orders.GroupBy(o => o.OrderId))
		{
			@* Lấy trạng thái đơn hàng và xác định class, text, icon tương ứng *@
			var orderStatus = orderGroup.FirstOrDefault()?.OrderStatus ?? 0;
			var statusClass = $"order-status-{orderStatus}";
			var statusText = orderStatus == 0 ? "Chờ xử lý" :
							orderStatus == 1 ? "Đã xác nhận" :
							orderStatus == 2 ? "Đang giao hàng" :
							orderStatus == 3 ? "Đã hủy" :
							orderStatus == 4 ? "Hoàn thành" : "Không xác định";
			var statusIcon = orderStatus == 0 ? "fa-clock" :
							orderStatus == 1 ? "fa-check-circle" :
							orderStatus == 2 ? "fa-truck" :
							orderStatus == 3 ? "fa-times-circle" :
							orderStatus == 4 ? "fa-check-double" : "fa-question-circle";

			@* Card chứa thông tin một đơn hàng *@
			<div class="order-card">
				@* Header của order card - Hiển thị ID và trạng thái *@
				<div class="order-card-header">
					<p class="order-id">
						<i class="fas fa-receipt"></i> Đơn hàng <span>#@orderGroup.Key</span>
					</p>
					@* Badge trạng thái đơn hàng *@
					<span class="order-status-badge @statusClass">
						<i class="fas @statusIcon"></i> @statusText
					</span>
				</div>

				@* Danh sách sản phẩm trong đơn hàng *@
				<div class="order-items">
					@foreach (var item in orderGroup)
					{
						@* Tìm thông tin sản phẩm từ danh sách products *@
						var product = productsList?.FirstOrDefault(p => p.Id == item.ProductId);
						
						@* Mỗi item sản phẩm trong đơn hàng *@
						<div class="order-item">
							@* Hình ảnh sản phẩm *@
							<img src="@(string.IsNullOrEmpty(product?.Image) ? "/img/default.jpg" : product.Image)" 
								 alt="@(product?.Name ?? "Sản phẩm")" 
								 class="order-item-image"
								 onerror="this.src='/img/default.jpg'">
							
							@* Thông tin sản phẩm (tên, mã, số lượng) *@
							<div class="order-item-info">
								<div class="order-item-name">@(product?.Name ?? "Không tìm thấy sản phẩm")</div>
								<p class="order-item-id">Mã SP: @item.ProductId | Số lượng: @item.Quantity</p>
							</div>
							
							@* Giá tiền của sản phẩm *@
							<div class="order-item-price">
								<span class="order-item-price-label">Tổng tiền</span>
								@((item.UnitPrice * item.Quantity - item.DiscountPrice).ToString("#,##0"))₫
							</div>
						</div>
					}
				</div>

				@* Footer của order card - Nút xem chi tiết *@
				<div class="order-card-footer">
					<button class="btn btn-detail-order" data-orderId="@orderGroup.Key">
						<i class="fas fa-eye"></i> Xem chi tiết
					</button>
				</div>
			</div>
		}
	}
	else
	{
		@* Empty state - Hiển thị khi không có đơn hàng *@
		<div class="empty-order-state">
			<i class="fas fa-shopping-bag"></i>
			<h5>Không tìm thấy đơn hàng nào</h5>
			<p>Vẫn còn rất nhiều sản phẩm đang chờ bạn khám phá</p>
			<a href="/">
				<i class="fas fa-chevron-left"></i> Về trang chủ
			</a>
		</div>
	}

	@* Phân trang - Hiển thị nếu có đơn hàng và có nhiều hơn 1 trang *@
	@if (orders.Any() && Model != null && Model.TotalPages > 1)
	{
		<div class="order-pagination-container">
			<div class="order-pagination-info">
				Hiển thị <strong>@((Model.CurrentPage - 1) * Model.PageSize + 1)</strong> - 
				<strong>@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount))</strong> 
				trong tổng số <strong>@Model.TotalCount</strong> đơn hàng
			</div>
			<nav class="order-pagination">
				<ul class="pagination">
					@* Nút Previous *@
					<li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
						@if (Model.HasPreviousPage)
						{
							<a class="page-link order-page-link" href="#" data-page="@(Model.CurrentPage - 1)" data-status="@Model.OrderStatus">
								<i class="fas fa-chevron-left"></i> Trước
							</a>
						}
						else
						{
							<span class="page-link"><i class="fas fa-chevron-left"></i> Trước</span>
						}
					</li>

					@* Hiển thị các số trang *@
					@{
						int startPage = Math.Max(1, Model.CurrentPage - 2);
						int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
					}

					@if (startPage > 1)
					{
						<li class="page-item">
							<a class="page-link order-page-link" href="#" data-page="1" data-status="@Model.OrderStatus">1</a>
						</li>
						@if (startPage > 2)
						{
							<li class="page-item disabled">
								<span class="page-link">...</span>
							</li>
						}
					}

					@for (int i = startPage; i <= endPage; i++)
					{
						<li class="page-item @(i == Model.CurrentPage ? "active" : "")">
							@if (i == Model.CurrentPage)
							{
								<span class="page-link">@i</span>
							}
							else
							{
								<a class="page-link order-page-link" href="#" data-page="@i" data-status="@Model.OrderStatus">@i</a>
							}
						</li>
					}

					@if (endPage < Model.TotalPages)
					{
						@if (endPage < Model.TotalPages - 1)
						{
							<li class="page-item disabled">
								<span class="page-link">...</span>
							</li>
						}
						<li class="page-item">
							<a class="page-link order-page-link" href="#" data-page="@Model.TotalPages" data-status="@Model.OrderStatus">@Model.TotalPages</a>
						</li>
					}

					@* Nút Next *@
					<li class="page-item @(Model.HasNextPage ? "" : "disabled")">
						@if (Model.HasNextPage)
						{
							<a class="page-link order-page-link" href="#" data-page="@(Model.CurrentPage + 1)" data-status="@Model.OrderStatus">
								Sau <i class="fas fa-chevron-right"></i>
							</a>
						}
						else
						{
							<span class="page-link">Sau <i class="fas fa-chevron-right"></i></span>
						}
					</li>
				</ul>
			</nav>
		</div>
	}
</div>


