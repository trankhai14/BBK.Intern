@using MyProject.Web.Models.Home
@using MyProject.Web.Startup
@{
	ViewBag.Title = L("HomePage");
	ViewBag.CurrentPageName = PageNames.Home;
}
@using MyProject.Web.Models.Products
@using MyProject.Web.Views.Shared.Components.Body
@using MyProject.Web.Models.FlashSales
@model HomePageViewModel

@section scripts
{
	<environment names="Development">
		<script src="~/view-resources/Views/Home/Index.js" asp-append-version="true"></script>
		<script src="~/view-resources/Views/FlashSales/Index.js" asp-append-version="true"></script>
	</environment>

	<environment names="Staging,Production">
		<script src="~/view-resources/Views/Home/Index.min.js" asp-append-version="true"></script>
		<script src="~/view-resources/Views/FlashSales/Index.min.js" asp-append-version="true"></script>
	</environment>
}

<link href="/css/homeweb.css" rel="stylesheet" />
<link href="/css/flashsale.css" rel="stylesheet" />

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

@* @await Html.PartialAsync("HeaderWeb") *@


<!-- Nội dung trang -->
<div class="container mt-4" style="max-width: 1200px !important">
	<!--Carousel-->
	@if (Model.ProductData.SliderList != null && Model.ProductData.SliderList.Any())
	{
		<div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel">
			<!-- Indicators (Dấu chấm điều hướng) -->
			<ol class="carousel-indicators">
				@{
					int index = 0;
				}
				@foreach (var slider in Model.ProductData.SliderList)
				{
					<li data-target="#carouselExampleIndicators" data-slide-to="@index" class="@(index == 0 ? "active" : "")"></li>
					index++;
				}
			</ol>

			<!-- Danh sách ảnh slider -->
			<div class="carousel-inner">
				@{
					index = 0;
				}
				@foreach (var slider in Model.ProductData.SliderList)
				{
					<div class="carousel-item @(index == 0 ? "active" : "")">
						<img class="d-block w-100" src="@slider.Image" alt="@slider.Title">
						@* <div class="carousel-caption d-none d-md-block">
							<h5>@slider.Title</h5>
							<p>@slider.Description</p>
						</div> *@
					</div>
					index++;
				}
			</div>

			<!-- Nút điều hướng -->
			<a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
				<span class="carousel-control-prev-icon" aria-hidden="true"></span>
				<span class="sr-only">Previous</span>
			</a>
			<a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
				<span class="carousel-control-next-icon" aria-hidden="true"></span>
				<span class="sr-only">Next</span>
			</a>
		</div>
	}
	else
	{
		<p>Không có slider nào đang hoạt động.</p>
	}

	<!-- FlashSale Section -->
	@if (Model.FlashSales != null && Model.FlashSales.Any())
	{
		@await Html.PartialAsync("_FlashSaleSection", Model.FlashSales)
	}

	<div class="product-list-title">
		<h2 class="mt-2" style="font-weight: 700;
    color: #1d2939;
    line-height: 32px;">
			Sản phẩm mới
		</h2>
		<div>
			<a class="related-tag btn-all-product" href="#">Xem tất cả</a>
		</div>
	</div>

	<div id="product-slider" class="product-slider-container position-relative">
		<!-- Danh sách sản phẩm -->
		<div class="product-list d-flex flex-nowrap">
			@foreach (var product in Model.ProductData.Products)
			{
				<div class="product-card-modern">
					<div class="card product-card-wrapper">
						<!-- Phần hình ảnh sản phẩm -->
						<div class="product-image-wrapper">
							<img src="@(string.IsNullOrEmpty(product.Image) ? "/img/default.jpg" : product.Image)"
								 class="product-image-main btn-view-detail" 
								 alt="@product.Name" 
								 data-id="@product.Id">
							<!-- Badge giảm giá (nếu có) -->
							<div class="product-badge">-10%</div>
							<!-- Nút yêu thích -->
							<button class="product-favorite-btn" type="button">
								<i class="far fa-heart"></i>
							</button>
						</div>
						
						<!-- Phần thông tin sản phẩm -->
						<div class="card-body product-info">
							<!-- Tên sản phẩm -->
							<h5 class="product-title btn-view-detail" data-id="@product.Id">@product.Name</h5>
							
							<!-- Đánh giá sao -->
							<div class="product-rating-modern">
								<div class="stars">
									<i class="fas fa-star"></i>
									<i class="fas fa-star"></i>
									<i class="fas fa-star"></i>
									<i class="fas fa-star"></i>
									<i class="fas fa-star"></i>
								</div>
								<span class="rating-text">(128)</span>
							</div>
							
							<!-- Giá sản phẩm -->
							<div class="product-price-section">
								<span class="product-price-current">@String.Format("{0:N0}", product.Price) đ</span>
								<span class="product-price-old">@String.Format("{0:N0}", 10000000) đ</span>
							</div>
							
							<!-- Thông tin khuyến mãi -->
							<div class="product-promo">
								<i class="fas fa-gift"></i>
								<span>Smember giảm thêm đến <strong>10%</strong></span>
							</div>
						</div>
					</div>
				</div>
			}
		</div>

		<!-- Nút điều hướng -->
		<button id="prevBtn" class="slider-btn prev-btn">
			<i class="fas fa-chevron-left"></i>
		</button>
		<button id="nextBtn" class="slider-btn next-btn">
			<i class="fas fa-chevron-right"></i>
		</button>
	</div>

	@foreach (var category in Model.CategoryProducts)
	{
		<div class="category-section">
			@if (category.Products.Any())
			{
				<div class="d-flex justify-content-between align-items-center">
					<h3 class="text-primary mt-3">@category.CategoryName</h3>
					<div>
						<a class="related-tag btn-all-product-byId" data-id="@category.CategoryId" href="#">Xem tất cả</a>
					</div>
				</div>
				<div class="container-items">
					@foreach (var product in category.Products)
					{
						<div class="product-card-modern">
							<div class="card product-card-wrapper">
								<!-- Phần hình ảnh sản phẩm -->
								<div class="product-image-wrapper">
									<img data-id="@product.Id" 
										 class="product-image-main btn-view-detail" 
										 src="@(string.IsNullOrEmpty(product.Image) ? "/img/default.jpg" : product.Image)" 
										 alt="@product.Name">
									<!-- Badge giảm giá -->
									<div class="product-badge">-10%</div>
									<!-- Nút yêu thích -->
									<button class="product-favorite-btn" type="button">
										<i class="far fa-heart"></i>
									</button>
								</div>
								
								<!-- Phần thông tin sản phẩm -->
								<div class="card-body product-info">
									<!-- Tên sản phẩm -->
									<h5 class="product-title btn-view-detail" data-id="@product.Id">@product.Name</h5>
									
									<!-- Đánh giá sao -->
									<div class="product-rating-modern">
										<div class="stars">
											<i class="fas fa-star"></i>
											<i class="fas fa-star"></i>
											<i class="fas fa-star"></i>
											<i class="fas fa-star"></i>
											<i class="fas fa-star"></i>
										</div>
										<span class="rating-text">(128)</span>
									</div>
									
									<!-- Giá sản phẩm -->
									<div class="product-price-section">
										<span class="product-price-current">@String.Format("{0:N0}", product.Price) đ</span>
										<span class="product-price-old">@String.Format("{0:N0}", 10000000) đ</span>
									</div>
									
									<!-- Thông tin khuyến mãi -->
									<div class="product-promo">
										<i class="fas fa-gift"></i>
										<span>Smember giảm thêm đến <strong>10%</strong></span>
									</div>
								</div>
							</div>
						</div>
					}
				</div>
			}
			else
			{
				<!-- <p class="text-muted">Không có sản phẩm nào trong danh mục này.</p> -->
			}
		</div>
	}

</div>







