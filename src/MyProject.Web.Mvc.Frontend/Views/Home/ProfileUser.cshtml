@using MyProject.Web.Models.Orders
@model FilterStatusOrderViewModel

@* Link CSS files *@
<link href="/css/homeweb.css" rel="stylesheet" />
<link href="/css/profile-user.css" rel="stylesheet" />

@* ============================================
   MAIN PROFILE PAGE LAYOUT
   ============================================ *@
<div class="profile-container">
	<div class="container">
		@* Breadcrumb Navigation *@
		<div class="row">
			<div class="col-md-12 mb-3">
				<nav aria-label="breadcrumb" class="breadcrumb-modern">
					<ol class="breadcrumb">
						<li class="breadcrumb-item"><a href="/Home">Trang chủ</a></li>
						<li class="breadcrumb-item active" aria-current="page">Thông tin tài khoản</li>
					</ol>
				</nav>
			</div>
		</div>

		<div class="row">
			@* ============================================
			   SIDEBAR - Menu điều hướng
			   ============================================ *@
			<div class="col-md-3 mb-4">
				<div class="profile-sidebar">
					@* Header của sidebar *@
					<div class="profile-header">
						<h5><i class="fas fa-user-circle"></i> Tài khoản của tôi</h5>
					</div>

					@* Menu items *@
					<div class="profile-menu">
						@* Menu: Đơn hàng đã mua *@
						<a href="#" class="profile-menu-item load-content active" data-view="_OrderList">
							<i class="fas fa-shopping-bag"></i>
							<span>Đơn hàng đã mua</span>
						</a>
						@* Menu: Thông tin và địa chỉ *@
						<a href="#" class="profile-menu-item load-content" data-view="_UserInfos">
							<i class="fas fa-address-card"></i>
							<span>Thông tin và địa chỉ</span>
						</a>
					</div>

					@* Nút đăng xuất *@
					<a class="profile-logout" href="/Account/Logout">
						<i class="fas fa-sign-out-alt"></i> Đăng xuất
					</a>

					@* Banner VIP *@
					<div class="profile-vip-banner">
						<h6><i class="fas fa-gift"></i> Quà Tặng VIP</h6>
						<p>Tích điểm cho khách hàng thân thiết</p>
						<div class="d-flex justify-content-center gap-2">
							<img src="/img/appstore.png" alt="App Store" style="width: 90px; height: auto;">
							<img src="/img/googleplay.png" alt="Google Play" style="width: 90px; height: auto;">
						</div>
					</div>
				</div>
			</div>

			@* ============================================
			   MAIN CONTENT AREA
			   ============================================ *@
			<div class="col-md-9">
				<div class="profile-content">
					@* Container sẽ được load động nội dung (_OrderList hoặc _UserInfos) *@
					<div id="mainContent" style="padding: 25px;">
						@await Html.PartialAsync("_OrderList.cshtml")
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section scripts
{
	<script src="~/view-resources/Views/Home/Profile.js"></script>
	<script>
		// Cập nhật active state cho menu items
		$(document).on('click', '.profile-menu-item', function() {
			$('.profile-menu-item').removeClass('active');
			$(this).addClass('active');
		});
	</script>
}
