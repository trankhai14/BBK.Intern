@using Abp.Authorization.Users
@model MyProject.Web.Models.Account.RegisterViewModel
@{
    ViewBag.Title = L("Register");
}
@section scripts
{
    <environment names="Development">
        <script src="~/view-resources/Views/Account/Register.js" asp-append-version="true"></script>
    </environment>

    <environment names="Staging,Production">
        <script src="~/view-resources/Views/Account/Register.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="register-form-container">
    <div class="register-header">
        <h2 class="register-title">@L("Register")</h2>
        <p class="register-subtitle">Tạo tài khoản mới để bắt đầu</p>
    </div>

    <form id="RegisterForm" asp-action="Register" method="post" class="register-form" novalidate>
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert-modern alert-danger-modern">
                <i class="fas fa-exclamation-circle"></i>
                <span>@ViewBag.ErrorMessage</span>
            </div>
        }
        
        <input type="hidden" name="IsExternalLogin" value="@Model.IsExternalLogin.ToString()" />
        <input type="hidden" name="ExternalLoginAuthSchema" value="@Model.ExternalLoginAuthSchema" />
        
        <div class="form-row-modern">
            <div class="form-group-modern">
                <div class="input-wrapper">
                    <div class="input-icon-wrapper">
                        <i class="input-icon fas fa-id-card"></i>
                    </div>
                    <input type="text" 
                           name="Name" 
                           class="form-control-modern" 
                           placeholder="@L("Name")" 
                           value="@Model.Name" 
                           maxlength="@AbpUserBase.MaxNameLength"
                           data-required="true">
                    <span class="error-message"></span>
                </div>
            </div>
            
            <div class="form-group-modern">
                <div class="input-wrapper">
                    <div class="input-icon-wrapper">
                        <i class="input-icon fas fa-id-card"></i>
                    </div>
                    <input type="text" 
                           name="Surname" 
                           class="form-control-modern" 
                           placeholder="@L("Surname")" 
                           value="@Model.Surname" 
                           maxlength="@AbpUserBase.MaxSurnameLength"
                           data-required="true">
                    <span class="error-message"></span>
                </div>
            </div>
        </div>

        <div class="form-group-modern">
            <div class="input-wrapper">
                <div class="input-icon-wrapper">
                    <i class="input-icon fas fa-envelope"></i>
                </div>
                <input type="email" 
                       name="EmailAddress" 
                       class="form-control-modern" 
                       placeholder="@L("EmailAddress")" 
                       value="@Model.EmailAddress" 
                       maxlength="@AbpUserBase.MaxEmailAddressLength"
                       data-required="true"
                       data-email="true">
                <span class="error-message"></span>
            </div>
        </div>

        <div class="form-group-modern">
            <div class="input-wrapper">
                <div class="input-icon-wrapper">
                    <i class="input-icon fas fa-user"></i>
                </div>
                <input type="text" 
                       name="UserName" 
                       class="form-control-modern" 
                       placeholder="@L("UserName")" 
                       value="@Model.UserName" 
                       maxlength="@AbpUserBase.MaxUserNameLength"
                       data-required="true">
                <span class="error-message"></span>
            </div>
        </div>

        <div class="form-group-modern">
            <div class="input-wrapper">
                <div class="input-icon-wrapper">
                    <i class="input-icon fas fa-lock"></i>
                </div>
                <input type="password" 
                       name="Password" 
                       class="form-control-modern" 
                       placeholder="@L("Password")" 
                       maxlength="@AbpUserBase.MaxPlainPasswordLength"
                       data-required="true">
                <span class="error-message"></span>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Login" class="btn-back-modern">
                <i class="fas fa-arrow-left"></i>
                <span>@L("Back")</span>
            </a>
            <button type="submit" id="RegisterButton" class="btn-register-modern">
                <span>@L("Register")</span>
                <i class="fas fa-user-plus"></i>
            </button>
        </div>
    </form>
</div>
