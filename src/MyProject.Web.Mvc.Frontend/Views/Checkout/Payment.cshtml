@model MyProject.Web.Models.Checkout.CheckoutPaymentViewModel

@section styles
{
	<style>
		.payment-info-card {
			background: #ffffff;
			border-radius: 12px;
			border: 1px solid #e9ecef;
		}

		.payment-summary-list .payment-product-item {
			border-bottom: 1px dashed #e9ecef;
			padding-bottom: 12px;
			margin-bottom: 12px;
		}

		.payment-summary-list .payment-product-item:last-child {
			border-bottom: none;
			margin-bottom: 0;
			padding-bottom: 0;
		}

		.payment-thumb {
			width: 60px;
			height: 60px;
			border-radius: 8px;
			background: #f8f9fa;
			display: flex;
			align-items: center;
			justify-content: center;
			overflow: hidden;
		}

		.payment-thumb img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.payment-thumb-placeholder {
			color: #adb5bd;
			font-size: 20px;
		}
	</style>
}

@section scripts
{
	<environment names="Development">
		<script src="~/view-resources/Views/Checkout/Payment.js" asp-append-version="true"></script>
	</environment>
}

<div class="container mt-3" style="max-width: 840px;">
	<h3 class="mb-3"><i class="fas fa-qrcode"></i> Thanh toán chuyển khoản QR</h3>

	<!-- Payment Status Display -->
	<div id="paymentStatus" data-is-paid="@(Model.OrderId > 0 ? "false" : "false")" data-order-id="@Model.OrderId">
		<div class="alert alert-info" id="paymentStatusAlert">
			<i class="fas fa-clock"></i> Đang chờ thanh toán...
			<br>
			<small>Hệ thống sẽ tự động kiểm tra thanh toán mỗi 10 giây</small>
		</div>
	</div>

	<!-- Loading indicator -->
	<div id="paymentChecking" style="display: none;" class="text-center mb-3">
		<i class="fas fa-spinner fa-spin"></i> Đang kiểm tra thanh toán...
	</div>

	<div class="row">
		<div class="col-lg-6 mb-3">
			<div class="payment-info-card p-4 text-center h-100">
				<p class="mb-1">Quét mã bằng ứng dụng ngân hàng để thanh toán</p>
				<p class="h4 mb-3 text-danger"><strong>@String.Format("{0:N0}", Model.OrderAmount) ₫</strong></p>

				@if (!string.IsNullOrEmpty(Model.QrImageUrl))
				{
					<img src="@Model.QrImageUrl" alt="VietQR" style="max-width:320px;width:100%;border:8px solid #f5f5f5;border-radius:12px;" />
				}

				<div class="mt-3 small text-muted text-left">
					<p class="mb-1">Ngân hàng: <strong>@Model.BankCode</strong></p>
					<p class="mb-1">Số tài khoản: <strong>@Model.BankAccount</strong> - @Model.BankAccountName</p>
					<p class="mb-1">Nội dung chuyển khoản: <strong>@Model.PaymentContent</strong></p>
					<p class="mb-1">Mã đơn hàng: <strong id="paymentReference" data-reference="@Model.PaymentReference">@Model.PaymentReference</strong></p>
					@if (Model.PaymentExpiredAt.HasValue)
					{
						<p class="mb-1">Hiệu lực đến: <strong>@Model.PaymentExpiredAt.Value.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</strong></p>
					}
				</div>

				<div class="mt-4">
					<a id="btnPaid"
					   class="btn btn-success"
					   data-order-id="@Model.OrderId">
						<i class="fas fa-check-circle"></i> Tôi đã thanh toán
					</a>
					<a href="/Checkout/Confirm" class="btn btn-link">Quay lại</a>
				</div>
			</div>
		</div>
		<div class="col-lg-6 mb-3">
			<div class="payment-info-card p-4 h-100">
				<h5 class="mb-3">Thông tin đơn hàng</h5>
				<div class="mb-3">
					<p class="mb-1"><strong>Khách hàng:</strong> @Model.FullName</p>
					@if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
					{
						<p class="mb-1"><strong>Điện thoại:</strong> @Model.PhoneNumber</p>
					}
					@if (!string.IsNullOrWhiteSpace(Model.Address))
					{
						<p class="mb-1"><strong>Địa chỉ:</strong> @Model.Address</p>
					}
					<p class="mb-1"><strong>Phương thức:</strong> Chuyển khoản QR ngân hàng</p>
					@if (!string.IsNullOrWhiteSpace(Model.Note))
					{
						<p class="mb-1"><strong>Ghi chú:</strong> @Model.Note</p>
					}
				</div>

				@if (Model.Items != null && Model.Items.Count > 0)
				{
					<div class="payment-summary-list">
						@foreach (var item in Model.Items)
						{
							<div class="payment-product-item media">
								<div class="payment-thumb mr-3">
									@if (!string.IsNullOrEmpty(item.Image))
									{
										<img src="@item.Image" alt="@item.ProductName" />
									}
									else
									{
										<div class="payment-thumb-placeholder"><i class="fas fa-box-open"></i></div>
									}
								</div>
								<div class="media-body">
									<div class="d-flex justify-content-between align-items-center">
										<strong>@item.ProductName</strong>
										<span class="text-danger font-weight-bold">@String.Format("{0:N0}", item.LineTotal) ₫</span>
									</div>
									<div class="d-flex justify-content-between text-muted small">
										<span>Số lượng: @item.Quantity</span>
										<span>Đơn giá: @String.Format("{0:N0}", item.UnitPrice) ₫</span>
									</div>
								</div>
							</div>
						}
					</div>
				}
			</div>
		</div>
	</div>

	<div class="alert alert-info mt-3">
		<i class="fas fa-info-circle"></i> Sau khi chuyển khoản thành công, đơn hàng sẽ được xác nhận. Nếu chưa được cập nhật tự động, vui lòng bấm “Tôi đã thanh toán” để hoàn tất.
	</div>
</div>

